            strokeWidth={2}
            d="M19 9l-7 7-7-7"
          />
        </svg>
      </button>

      <motion.div
        id={contentId}
        initial={false}
        animate={{
          height: isOpen ? "auto" : 0,
          opacity: isOpen ? 1 : 0,
        }}
        transition={{ duration: 0.3 }}
        className="overflow-hidden"
        aria-hidden={!isOpen}
      >
        <div className="p-4">{children}</div>
      </motion.div>
    </motion.section>
  );
}

export default function AboutPage() {
  return (
    <main className="min-h-screen p-8">
