            className="rounded-full bg-yellow-500 px-6 py-2 text-white transition-colors duration-300 hover:bg-yellow-600 disabled:cursor-not-allowed disabled:opacity-60"
          >
            {!isLeftEye
              ? "Try left eye"
              : "Go to improve vision"}
          </button>
        </div>
      </div>
    </div>
  );
}
