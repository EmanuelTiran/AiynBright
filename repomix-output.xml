    const { data: session } = useSession()
    const isUserLoggedIn = session && session.user;
    return (
        <div className="flex gap-4 ml-auto">
            {isUserLoggedIn ? (
                <>
                    <p className="text-sky-600">{session.user.name}</p>
                    <button onClick={signOut} className="text-red-600">
